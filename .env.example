# NVIDIA API Key (required) — get one at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Tavily API key (optional - used by CRAG for web-search fallback)
# Get one free at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith tracing (optional but recommended)
# Get an API key at https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=healthcare-nav
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Pinecone (required)
# Get an API key at https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=lightning-talk
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=healthcare-nav

# Model configuration
CHAT_MODEL=deepseek-ai/deepseek-v4-pro
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# Must match the embedding model's output width (e.g. nv-embedqa-e5-v5 → 1024,
# nemotron-3.5-embed-1b → 2048). Changing EMBEDDING_MODEL almost always means
# changing this too, and a new PINECONE_INDEX + a re-ingest (python ingest.py) —
# an existing index can't be resized, and old vectors are meaningless to a new model.
EMBEDDING_DIMENSION=1024
# Optional secondary chat model on the same NVIDIA endpoint, used automatically
# when the primary model errors or times out. Leave blank to disable.
CHAT_MODEL_FALLBACK=

# NVIDIA hybrid-reasoning models (nemotron-3.5-*) emit a hidden reasoning pass by
# default, which can eat the whole token budget (empty answer, broken structured
# output) and costs tens of seconds. Left false, the app disables it. Set true
# only for a model that needs reasoning, or one that rejects the template flag.
MODEL_THINKING_ENABLED=false

# Judge model for the offline evaluation harness (evaluate.py). Kept separate
# from CHAT_MODEL on purpose: a model grading its own answers inflates every
# score. gpt-oss-20b is slower than the demo model but is an independent judge.
EVAL_MODEL=openai/gpt-oss-20b

# LLM resilience: per-request timeout (seconds) and SDK-level retries per model
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Startup warm-up: one embedding + one tiny LLM call so the first demo query
# isn't slowed by cold connections. Set to false to skip.
WARMUP_ON_STARTUP=true

# Retrieval settings
DATA_DIR=./data
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
